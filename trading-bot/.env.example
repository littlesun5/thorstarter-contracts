# Backpack Exchange API Configuration
BACKPACK_API_KEY=your_api_key_here
BACKPACK_API_SECRET=your_api_secret_here

# Trading Configuration
SYMBOL=BTC-USDT
RSI_PERIOD=14
RSI_OVERSOLD=29
RSI_OVERBOUGHT=71

# Position Sizing (in BTC)
INITIAL_POSITION_SIZE=0.03
